# Copy this file to .env and fill in real values. .env is gitignored.

# From resend.com dashboard -> API Keys
RESEND_API_KEY=re_your_api_key_here

# Sender address. Until a custom domain is verified on Resend, this must
# stay onboarding@resend.dev (Resend's shared sandbox sender).
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# --- Production only (leave unset for local development) ---

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Set to False in production.
DEBUG=False

# Comma-separated list of domains this site is served from, e.g.
#   betterwithus.pythonanywhere.com
ALLOWED_HOSTS=

# Comma-separated, must include the scheme, e.g.
#   https://betterwithus.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
